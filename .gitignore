# Compiled CDK output sits next to its TypeScript sources.
# Scoped deliberately: a bare "*.js" here also swallowed web/next.config.js and
# web/postcss.config.js, so the web UI could not be built from a fresh clone.
/bin/*.js
/bin/*.d.ts
/lib/*.js
/lib/*.d.ts
/lambda/*.js
/lambda/*.d.ts
/scripts/*.js
/scripts/*.d.ts
node_modules

# CDK asset staging directory
.cdk.staging
cdk.out

# Compiled output
dist/

# Workspace lockfiles (only root package-lock.json should exist)
web/package-lock.json

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# AWS
.aws-sam
deployment-outputs.json
deployment-outputs.txt

# Temporary/WIP files
*-new.sh
*-old.sh
*-backup.*

# Local CI pass marker (scripts/ci-local-verdict.sh) - per-machine, never committed
.local-ci-pass.json
# Local CI pass cache (scripts/check-ci-local.mjs) - per-machine, never committed
.local-ci-cache.json
